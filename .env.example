# ─────────────────────────────────────────────────────────────────────────────
# Monumental Streams server configuration.
# Copy to .env (never commit .env). Real environment variables override this file.
# Every variable is optional in development; production requirements are noted.
# ─────────────────────────────────────────────────────────────────────────────

# development | production. Production enables Secure cookies, HSTS, serves DIST_DIR,
# requires the two secrets below and forces DEV_PREVIEW_MEMBERSHIP off.
# Left commented on purpose: Vite also reads .env, and NODE_ENV there would change
# `npm run build` output. Prefer setting it in the process environment.
# NODE_ENV=development

# API port and bind address. HOST defaults to 127.0.0.1 in development and 0.0.0.0 in
# production; set 0.0.0.0 explicitly to accept connections from other machines.
PORT=8787
HOST=127.0.0.1

# Public origin of the web app (scheme + host + port, no path). Used for the CSRF Origin
# check and for Stripe redirect URLs. Development default: http://localhost:5173 (Vite).
# Production: set to your public https origin, e.g. https://streams.example
APP_ORIGIN=http://localhost:5173

# Secrets (each at least 32 characters in production). Required in production.
# In development they are generated on first run and kept in DATA_DIR/dev-secrets.json.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET signs the CSRF cookie; PLAYBACK_TOKEN_SECRET signs stream tokens.
# Rotating PLAYBACK_TOKEN_SECRET invalidates playback links in flight (they last 4 hours).
SESSION_SECRET=
PLAYBACK_TOKEN_SECRET=

# Directories (relative to the working directory).
#   DATA_DIR     SQLite database (monumental.sqlite) and dev secrets
#   MEDIA_DIR    generated media: public/ (served at /media/public), protected/ (token-gated
#                at /stream), manifest.json, art.json
#   CONTENT_DIR  authored catalogue JSON (validate with: npm run content:check)
#   DIST_DIR     Vite build output served in production (npm run build)
DATA_DIR=./data
MEDIA_DIR=./media
CONTENT_DIR=./content
DIST_DIR=./dist

# ── Stripe billing (optional) ────────────────────────────────────────────────
# Billing is "configured" only when STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and at least
# one price id are set. Otherwise the app shows "setup pending" and takes no payment.
#
# Test mode (no real money):
#   1. In the Stripe Dashboard switch to Test mode, then Developers → API keys:
#      copy the secret key (sk_test_…) into STRIPE_SECRET_KEY.
#   2. Product catalogue → add a product with a recurring monthly and/or yearly price;
#      copy the price ids (price_…) into STRIPE_PRICE_MONTHLY / STRIPE_PRICE_YEARLY.
#   3. Settings → Billing → Customer portal: activate the test-mode portal (for "Manage").
#   4. Forward webhooks locally with the Stripe CLI:
#        stripe login
#        stripe listen --forward-to http://127.0.0.1:8787/api/billing/webhook \
#          --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.payment_failed
#      and paste the printed signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
#      In production, add a Dashboard webhook endpoint for https://<APP_ORIGIN>/api/billing/webhook
#      with the same events and use its signing secret.
#   5. Pay with test card 4242 4242 4242 4242, any future expiry, any CVC.
# Membership changes only when a verified webhook arrives — the redirect alone never does.
# Keys starting sk_test_ / rk_test_ run in "stripe-test" mode; any other key is "stripe-live".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Development membership preview: lets a signed-in reviewer switch their own membership
# between dev_preview / cancelled / expired / past_due / none via POST /api/dev/membership,
# with no payment. Defaults to true outside production; ALWAYS off in production.
DEV_PREVIEW_MEMBERSHIP=true

# Express "trust proxy" setting, needed behind a reverse proxy / load balancer so client
# IPs (rate limiting) and https detection are correct. Examples: true, 1, loopback,
# "loopback, 10.0.0.0/8". Leave empty when the server faces clients directly.
TRUST_PROXY=

{
  "name": "monumental-streams",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=shared --watch-path=content --disable-warning=ExperimentalWarning server/index.ts --dev-api",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "playwright test",
    "media:previews": "bash scripts/build-previews.sh",
    "media:build": "node --disable-warning=ExperimentalWarning scripts/build-media.ts",
    "globe:build": "node --disable-warning=ExperimentalWarning scripts/build-globe.ts",
    "content:check": "node --disable-warning=ExperimentalWarning scripts/content-check.ts",
    "content:add": "node --disable-warning=ExperimentalWarning scripts/content-add.ts",
    "media:archive-art": "bash scripts/build-archive-art.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
